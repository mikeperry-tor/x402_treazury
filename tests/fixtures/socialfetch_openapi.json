    "/v1/web/search": {
      "get": {
        "description": "Search the public web and return ranked organic results with snippets.",
        "parameters": [
          {
            "description": "Search query text to run against the public web.",
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "description": "Search query text to run against the public web.",
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Silent alias for query when query is omitted.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Silent alias for query when query is omitted.",
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "ISO 3166-1 country code for localized results (e.g. US, GB, CA).",
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "description": "ISO 3166-1 country code for localized results (e.g. US, GB, CA).",
              "type": "string"
            }
          },
          {
            "description": "Optional filter by when results were posted.",
            "in": "query",
            "name": "datePosted",
            "required": false,
            "schema": {
              "description": "Optional filter by when results were posted.",
              "enum": [
                "last-hour",
                "last-day",
                "last-week",
                "last-month",
                "last-year"
              ],
              "type": "string"
            }
          },
          {
            "description": "Page number (1-based). Default: 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (1-based). Default: 1.",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "summary": "Search the web",
        "tags": [
          "Web"
        ],
        "x-socialfetch-credits-pricing": "1 credit per successful request.",
