      },
      "post": {
        "description": "Create a monitor that polls a watchable source on a schedule.",
        "parameters": [
          {
            "description": "When true, validates the monitor and returns a cost preview without creating anything or running the baseline check.",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "When true, validates the monitor and returns a cost preview without creating anything or running the baseline check.",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request body for creating a monitor.",
                "properties": {
                  "name": {
                    "description": "Optional display name for the monitor. A default is generated from the source and params when omitted.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "operationId": {
                    "description": "Watchable public API operation id to poll. See GET /v1/monitors/sources.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "params": {
                    "additionalProperties": {
                      "nullable": true
                    },
                    "description": "Parameters for the watched operation.",
                    "type": "object"
                  },
                  "schedule": {
                    "description": "Polling schedule for a monitor: a fixed interval or a cron expression.",
                    "oneOf": [
                      {
                        "description": "Fixed-interval polling schedule.",
                        "properties": {
                          "minutes": {
                            "description": "Polling interval in minutes.",
                            "exclusiveMinimum": true,
                            "minimum": 0,
                            "type": "integer"
                          },
                          "type": {
                            "enum": [
                              "interval"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "minutes"
                        ],
                        "type": "object"
                      },
                      {
                        "description": "Cron-based polling schedule.",
                        "properties": {
                          "expression": {
                            "description": "Cron expression for polling.",
                            "minLength": 1,
                            "type": "string"
                          },
                          "timezone": {
                            "description": "IANA timezone the cron expression is evaluated in.",
                            "minLength": 1,
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "cron"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "expression",
                          "timezone"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "spendCapCredits": {
                    "description": "Optional monthly credit spend cap for this monitor.",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "webhook": {
                    "description": "Create a new webhook endpoint inline for this monitor. Mutually exclusive with `webhookEndpointId`.",
                    "properties": {
                      "url": {
                        "description": "HTTPS URL to deliver events to.",
                        "format": "uri",
                        "type": "string"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "type": "object"
                  },
                  "webhookEndpointId": {
                    "description": "Existing webhook endpoint id (owned by this account) to deliver events to. Mutually exclusive with `webhook`.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "operationId",
                  "params",
                  "schedule"
                ],
                "type": "object"
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "summary": "Create a monitor",
        "tags": [
          "Monitors"
        ],
        "x-socialfetch-credits-pricing": "0 credits per successful request.",
        "x-socialfetch-pricing": {
          "baseCredits": 0,
          "maxCredits": 0,
          "normalizationFailureCredits": 0,
          "surcharges": [],
          "version": 1
        }
