{
  "info": {
    "description": "REST API for Social Fetch. Versioned routes under `/v1` accept `x-api-key` credits or x402 USDC on Base (walk-up, no key). OpenAPI: https://api.socialfetch.dev/openapi.json. x402 discovery: https://api.socialfetch.dev/.well-known/x402. MCP: https://api.socialfetch.dev/mcp (POST). Docs and agent guide: https://www.socialfetch.dev/docs and https://www.socialfetch.dev/llms.txt.",
    "title": "Social Fetch Public API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/v1/twitter/profiles/{handle}": {
      "get": {
        "description": "Get an X (Twitter) profile by handle or numeric user id.",
        "parameters": [
          {
            "description": "X (Twitter) profile handle without the leading @, or a numeric user id.",
            "in": "path",
            "name": "handle",
            "required": true,
            "schema": {
              "description": "X (Twitter) profile handle without the leading @, or a numeric user id.",
              "type": "string"
            }
          },
          {
            "description": "Treat the path value as a handle or a numeric user id. Defaults to id when the value is all digits.",
            "in": "query",
            "name": "by",
            "required": false,
            "schema": {
              "description": "Treat the path value as a handle or a numeric user id. Defaults to id when the value is all digits.",
              "enum": [
                "id",
                "handle"
              ],
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "summary": "Get Twitter profile",
        "tags": [
          "Twitter"
        ],
        "x-socialfetch-credits-pricing": "1 credit per successful request.",
        "x-socialfetch-pricing": {
          "baseCredits": 1,
          "maxCredits": 1,
          "normalizationFailureCredits": 0,
          "surcharges": [],
          "version": 1
        }
      }
    },
