            "required": true,
            "schema": {
              "description": "LinkedIn profile URL.",
              "items": {
                "description": "LinkedIn profile URL, vanity handle, `@handle`, or `in/{handle}` path.",
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            }
