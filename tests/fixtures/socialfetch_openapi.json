      "post": {
        "description": "Create a webhook endpoint to receive signed monitor deliveries.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request body for creating a webhook endpoint.",
                "properties": {
                  "description": {
                    "description": "Optional human-readable label for this endpoint.",
                    "maxLength": 500,
                    "type": "string"
                  },
                  "kind": {
                    "description": "Delivery kind: `http` posts events to a customer-supplied URL; `sink` is a hosted test inbox with no URL (limited per account).",
                    "enum": [
                      "http",
                      "sink"
                    ],
                    "type": "string"
                  },
                  "url": {
                    "description": "Destination URL to receive event deliveries. Required when `kind` is `http`; must be a public HTTPS URL.",
                    "format": "uri",
                    "maxLength": 2048,
                    "type": "string"
                  }
                },
