  {
    "name": "blockrun_exa_answer",
    "description": "Get an AI-generated answer to a question grounded in live web search results. Price: $0.011 per call (vendor spec).",
    "method": "POST",
    "path": "/api/v1/exa/answer",
    "input_schema": {
      "properties": {
        "query": {
          "description": "Question to answer with grounded search.",
          "type": "string"
        },
        "text": {
          "default": false,
          "description": "Include full text of cited pages in response.",
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "param_routes": {
      "query": "body",
      "text": "body"
    },
    "has_body": true
  },
  {
    "name": "blockrun_exa_contents",
    "description": "Extract full text content from one or more URLs. Total = urls.length × $0.002 plus one transaction fee: $0.003 for a single URL, $0.201 at the 100-URL maximum.",
    "method": "POST",
    "path": "/api/v1/exa/contents",
    "input_schema": {
      "properties": {
        "highlights": {
          "description": "Exa highlights config.",
          "type": "object"
        },
        "summary": {
          "description": "Exa summary config.",
          "type": "object"
        },
        "text": {
          "default": true,
          "description": "Include extracted text.",
          "type": "boolean"
        },
        "urls": {
          "description": "List of URLs to extract content from. Price scales linearly with count: $0.003 for one, $0.201 for 100.",
          "items": {
            "format": "uri",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "urls"
      ],
      "type": "object"
    },
    "param_routes": {
      "highlights": "body",
      "summary": "body",
      "text": "body",
      "urls": "body"
    },
    "has_body": true
  },
  {
    "name": "blockrun_exa_find_similar",
    "description": "Find pages semantically similar to a given URL. Price: $0.011 per call (vendor spec).",
    "method": "POST",
    "path": "/api/v1/exa/find-similar",
    "input_schema": {
      "properties": {
        "excludeSourceDomain": {
          "default": true,
          "type": "boolean"
        },
        "numResults": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "url": {
          "description": "Source URL to find pages similar to.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "param_routes": {
      "excludeSourceDomain": "body",
      "numResults": "body",
      "url": "body"
    },
    "has_body": true
  },
  {
    "name": "blockrun_exa_search",
    "description": "Neural and keyword web search powered by Exa. Optional category filter: company, research paper, news, pdf, github, tweet, personal site, linkedin profile, financial report. Price: $0.011 per call (vendor spec).",
    "method": "POST",
    "path": "/api/v1/exa/search",
    "input_schema": {
      "properties": {
        "category": {
          "description": "Optional category filter (company, research paper, news, pdf, github, tweet, personal site, linkedin profile, financial report).",
          "type": "string"
        },
        "endPublishedDate": {
          "description": "ISO-8601 date.",
          "type": "string"
        },
        "excludeDomains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "includeDomains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "numResults": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "Search query.",
          "type": "string"
        },
        "startPublishedDate": {
          "description": "ISO-8601 date.",
          "type": "string"
        },
        "type": {
          "default": "auto",
          "enum": [
            "neural",
            "keyword",
            "auto"
          ],
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "param_routes": {
      "category": "body",
      "endPublishedDate": "body",
      "excludeDomains": "body",
      "includeDomains": "body",
      "numResults": "body",
      "query": "body",
      "startPublishedDate": "body",
      "type": "body"
    },
    "has_body": true
  },
  {
