  {
    "name": "blockrun_search",
    "description": "Real-time web and news search powered by xAI Grok with live data access. Price: $0.025–$1.25 per call, scaling with usage (vendor spec).",
    "method": "POST",
    "path": "/api/v1/search",
    "input_schema": {
      "properties": {
        "max_results": {
          "default": 10,
          "description": "Maximum number of results per source",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "Search query",
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "sources": {
          "default": [
            "x",
            "web"
          ],
          "description": "Data sources to search",
          "items": {
            "enum": [
              "x",
              "web",
              "news"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "param_routes": {
      "max_results": "body",
      "query": "body",
      "sources": "body"
    },
    "has_body": true
  }
]
