[
  {
    "name": "blockrun_chat_completions",
    "description": "Access 86 frontier LLMs with OpenAI-compatible API. Price depends on model and token usage. Price: $0.0001–$5.00 per call, scaling with usage (vendor spec).",
    "method": "POST",
    "path": "/api/v1/chat/completions",
    "input_schema": {
      "properties": {
        "max_tokens": {
          "description": "Set an explicit small output-token limit to bound the provider's pre-call quote and response size.",
          "maximum": 128000,
          "minimum": 1,
          "type": "integer"
        },
        "messages": {
          "description": "Array of chat messages",
          "items": {
            "properties": {
              "content": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ],
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "model": {
