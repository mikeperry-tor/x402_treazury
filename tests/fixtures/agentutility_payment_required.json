{
  "x402Version": 2,
  "error": "Payment required",
  "resource": {
    "url": "https://x402.agentutility.ai/web-search",
    "description": "Live web search and web answer engine retrieval API for agents that need ranked sources before writing an answer. Send a query and optional recency filter; receive ranked web results with title, URL, snippet, and domain, not an LLM-written response. Successful results are cached, and provider rate limits trigger a short circuit breaker plus a clearly marked recent public-news fallback. Use it as a web answer engine source API, live web search API, web search MCP tool, RAG source-discovery feed, or source search tool. For fetched page text or cited synthesis, use answer-web or scrape-to-json.",
    "mimeType": "application/json",
    "serviceName": "AgentUtility.ai",
    "tags": [
      "web-probe",
      "web",
      "search"
    ],
    "iconUrl": "https://agentutility.ai/icon-512.png"
  },
  "accepts": [
    {
      "scheme": "exact",
      "network": "eip155:8453",
