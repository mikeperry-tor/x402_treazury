    "/api/v1/commodity/history/XAU-USD": {
      "get": {
        "description": "Historical OHLC bars for one Commodity symbol. Symbol format: Commodity ticker `BASE-QUOTE` (e.g. XAU-USD for gold, WTI-USD for oil). Example: `XAU-USD`. Substitute the path tail with any valid symbol from /list.",
        "operationId": "commodityHistory",
        "parameters": [
          {
            "description": "Bar resolution. Common values: 1, 5, 15, 60, 240, D, W.",
            "in": "query",
            "name": "resolution",
            "required": false,
            "schema": {
              "default": "D",
              "type": "string"
            }
          },
          {
            "description": "Start unix timestamp (seconds).",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "End unix timestamp (seconds). Defaults to now.",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "session",
            "required": false,
            "schema": {
              "enum": [
                "regular",
                "extended"
              ],
              "type": "string"
            }
          }
        ],
        "security": [],
        "summary": "Commodity OHLC History"
      }
    },
