    "/api/v1/images/image2image": {
      "post": {
        "description": "Edit or vary an existing image with a text prompt. Send the source image (and optional mask) as a base64 data URI. OpenAI gpt-image-1 / gpt-image-2 support mask-based inpainting; the Google nano-banana family (nano-banana, nano-banana-2, nano-banana-pro) does prompt-only edits (mask not supported).",
        "operationId": "imageEdit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "image": {
                    "description": "Source image(s) as base64 data URI(s). Pass a single string, or an array (OpenAI-compatible image[]) to fuse multiple sources — e.g. a reference image + a brand logo. Max 4 for OpenAI, 3 for Google. Multi-image cannot be combined with mask.",
                    "oneOf": [
                      {
                        "pattern": "^data:image/",
                        "type": "string"
                      },
                      {
                        "items": {
                          "pattern": "^data:image/",
                          "type": "string"
                        },
                        "maxItems": 4,
                        "minItems": 1,
                        "type": "array"
                      }
                    ]
                  },
                  "mask": {
                    "description": "Optional mask as base64 data URI; transparent pixels mark the editable region. OpenAI models only — rejected for Google models.",
                    "pattern": "^data:image/",
                    "type": "string"
                  },
                  "model": {
                    "default": "openai/gpt-image-2",
                    "enum": [
                      "openai/gpt-image-1",
                      "openai/gpt-image-2",
                      "google/nano-banana",
                      "google/nano-banana-2",
                      "google/nano-banana-pro"
                    ],
                    "type": "string"
                  },
                  "n": {
                    "default": 1,
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "prompt": {
                    "description": "Edit instructions for the image.",
                    "type": "string"
                  },
                  "size": {
                    "default": "1024x1024",
                    "enum": [
                      "1024x1024",
                      "1792x1024",
                      "1024x1792"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "prompt",
                  "image"
