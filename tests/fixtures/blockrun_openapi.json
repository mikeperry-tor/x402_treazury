{
  "info": {
    "description": "Agent-native AI gateway. Pay-per-request with USDC on Base. No accounts or API keys required.",
    "title": "BlockRun AI Gateway",
    "version": "1.0.0",
    "x-logo": {
      "altText": "BlockRun",
      "url": "https://blockrun.ai/brand/logo-256.png"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/audio/generations": {
      "post": {
        "description": "Generate music tracks with MiniMax Music 2.5+. Provide a text prompt describing the song; optionally supply lyrics or set instrumental=true. Flat price per track regardless of duration.",
        "operationId": "audioGenerations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "duration_seconds": {
                    "default": 30,
                    "maximum": 240,
                    "minimum": 5,
                    "type": "integer"
                  },
                  "instrumental": {
                    "default": false,
                    "description": "If true, generate an instrumental track.",
                    "type": "boolean"
                  },
                  "lyrics": {
                    "description": "Optional song lyrics. Ignored when instrumental=true.",
                    "type": "string"
                  },
                  "model": {
                    "default": "minimax/music-2.5+",
                    "enum": [
                      "minimax/music-2.5+"
                    ],
                    "type": "string"
                  },
                  "prompt": {
                    "description": "High-level description of the song (genre, mood, instrumentation).",
                    "type": "string"
                  }
                },
                "required": [
                  "prompt"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "x402": []
          }
        ],
        "summary": "Music Generation",
        "x-agentcash-auth": {
          "mode": "paid"
        },
        "x-payment-info": {
          "price": {
            "currency": "USD",
            "max": "0.151",
            "min": "0.151",
            "mode": "dynamic"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/api/v1/audio/sound-effects": {
      "post": {
        "description": "Generate a cinematic sound effect from a text prompt (up to 22s). Flat price per generation.",
        "operationId": "audioSoundEffects",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "duration_seconds": {
                    "maximum": 22,
                    "minimum": 0.5,
                    "type": "number"
                  },
                  "model": {
                    "default": "elevenlabs/sound-effects",
                    "enum": [
                      "elevenlabs/sound-effects"
                    ],
                    "type": "string"
                  },
                  "prompt_influence": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "response_format": {
                    "default": "mp3",
                    "enum": [
                      "mp3",
                      "opus",
                      "pcm",
                      "wav"
                    ],
                    "type": "string"
                  },
                  "text": {
                    "description": "Description of the sound effect.",
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "x402": []
          }
        ],
        "summary": "Sound Effects (ElevenLabs)",
        "x-agentcash-auth": {
          "mode": "paid"
        },
        "x-payment-info": {
          "price": {
            "amount": "0.0535",
            "currency": "USD",
            "mode": "fixed"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/api/v1/audio/speech": {
      "post": {
        "description": "Synthesize speech from text with ElevenLabs (Flash v2.5 for real-time agents, Multilingual v2 / Eleven v3 for narration). Billed per input character; the exact price is quoted in the 402. Returns a hosted MP3 URL.",
        "operationId": "audioSpeech",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "input": {
                    "description": "Text to synthesize into speech.",
                    "type": "string"
                  },
                  "model": {
                    "default": "elevenlabs/flash-v2.5",
                    "enum": [
                      "elevenlabs/flash-v2.5",
                      "elevenlabs/turbo-v2.5",
                      "elevenlabs/multilingual-v2",
                      "elevenlabs/v3"
                    ],
                    "type": "string"
                  },
                  "response_format": {
                    "default": "mp3",
                    "enum": [
                      "mp3",
                      "opus",
                      "pcm",
                      "wav"
                    ],
                    "type": "string"
                  },
                  "speed": {
                    "maximum": 1.2,
                    "minimum": 0.7,
                    "type": "number"
                  },
                  "voice": {
                    "default": "sarah",
                    "description": "Voice alias (e.g. sarah, george) or raw ElevenLabs voice_id.",
                    "type": "string"
                  }
                },
                "required": [
                  "input"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "x402": []
          }
        ],
        "summary": "Text-to-Speech (ElevenLabs)",
        "x-agentcash-auth": {
          "mode": "paid"
        },
        "x-payment-info": {
          "price": {
            "currency": "USD",
            "max": "2.100",
            "min": "0.001",
            "mode": "dynamic"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
