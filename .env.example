# Wallet keys — copy to .env (never commit real keys)
EVM_PRIVATE_KEY=

# Optional Solana wallet (base58). Requires: uv sync --extra svm
SVM_PRIVATE_KEY=

# Per-payment spend cap in USD. Set to "none" to disable spend controls entirely.
X402_MAX_PRICE_USD=1.00

# Bearer token for http streaming mcp
X402_MCP_BEARER_TOKEN=
