# Static Base USDC wallet — copy to .env; never commit real keys.
EVM_PRIVATE_KEY=

# Per-payment amount cap; "none" disables the cap, retaining the Base USDC allowlist.
X402_MAX_PRICE_USD=1.00

# Bearer token for standalone Streamable HTTP MCP.
# Multi-server deployments name their token/key variables in TOML.
X402_MCP_BEARER_TOKEN=
