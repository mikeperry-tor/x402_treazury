# Managed Zcash treasury setup — copy to .env; never commit secrets.
# Copy examples/deployments/managed.toml to managed.local.toml beside it first.
# Load into your shell before running wallet or serve commands (from the repo root):
#   set -a
#   . ./.env
#   set +a
# .env is not loaded automatically. --env-file loads after CLI parsing and cannot
# select the deployment through X402_TREAZURY_CONFIG.
X402_TREAZURY_CONFIG=examples/deployments/managed.local.toml

# Replace with your own secret bearer token for the example deployment listeners.
# Omit this variable to allow unauthenticated access; an empty value is rejected.
X402_TREAZURY_MCP_TOKEN=replace_with_a_secret_bearer_token

# Optional Base RPC override when funding.base_rpc_url_env = "BASE_RPC_URL".
# Leave unset to use the built-in Base RPC failover list.
# BASE_RPC_URL=https://your-base-rpc.example

# Run wallet init to initialize the treasury; managed EVM keys are generated and
# stored in encrypted state, so no EVM private key belongs in this setup.
# Set each wallet's max_api_payment_usdc in the deployment TOML.
# Standalone provider environment options are documented in docs/configuration.md.
