+/// The scan floor can move earlier after a fork crosses the declared birthday.
+/// Its existing persisted ranges retain that coverage; metadata and keys stay put.
+fn scan_birthday<W: SyncWallet>(wallet: &W) -> Result<BlockHeight, SyncError<W::Error>> {
+    let declared = wallet.get_birthday().map_err(SyncError::WalletError)?;
+    Ok(wallet
+        .get_sync_state()
+        .map_err(SyncError::WalletError)?
+        .wallet_birthday()
+        .map_or(declared, |floor| floor.min(declared)))
+}
+
+/// Rebuild an interrupted scan whose retained boundary metadata no longer
+/// supports its recorded scanned ranges. New-chain bounds cannot certify the
+/// old prefix, so use the existing full canonical rescan instead.
+fn restore_missing_scanned_bounds<W>(
+    wallet: &mut W,
+    consensus_parameters: &impl consensus::Parameters,
+) -> Result<(), SyncError<W::Error>>
+where
+    W: SyncWallet + SyncBlocks + SyncTransactions + SyncNullifiers + SyncOutPoints + SyncShardTrees,
+{
+    let bounds = wallet
+        .get_sync_state()
+        .map_err(SyncError::WalletError)?
+        .scan_ranges()
+        .iter()
+        .filter(|range| range.priority().is_scanned())
+        .flat_map(|range| [range.block_range().start, range.block_range().end - 1])
+        .collect::<Vec<_>>();
+    let blocks = wallet
+        .get_wallet_blocks_mut()
+        .map_err(SyncError::WalletError)?;
+    if bounds.iter().all(|height| blocks.contains_key(height)) {
+        return Ok(());
+    }
+    tracing::info!(
+        "Saved Zcash scan boundaries are unavailable; rebuilding wallet observations from supported history"
+    );
+    clear_wallet_data(wallet, consensus_parameters)
+}
