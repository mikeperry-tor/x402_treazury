    "/tools/timeline": {
      "post": {
        "summary": "Timeline Endpoint",
        "description": "How has coverage of this topic developed over time, across every\naggregated source? Chronologically ordered (oldest first), unlike\n/tools/search (relevance-ranked) or /tools/digest (grouped by\ncategory) -- for tracking a story's evolution or an emerging trend\nacross independently-sourced outlets.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "limit": {
                    "default": 30,
                    "maximum": 100.0,
                    "minimum": 1.0,
                    "title": "Limit",
                    "type": "integer"
